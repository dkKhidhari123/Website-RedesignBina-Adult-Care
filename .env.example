# ─── Server-only (set in Vercel → Project → Settings → Environment Variables) ───
# Never prefix these with VITE_ — that would expose them in the browser bundle.

# Private Vercel Blob store: form submissions, resumes, dashboard content and uploaded photos.
# Added automatically when you connect the store (Vercel → Storage → Create → Blob, access "Private").
# Not needed for `npm run dev` — locally everything is saved in ./.data instead.
BLOB_READ_WRITE_TOKEN=

# Optional: email notification for each new inquiry via Resend (https://resend.com)
RESEND_API_KEY=
# Where notifications are sent, e.g. binasadultcare@gmail.com
CONTACT_NOTIFY_EMAIL=
# Verified sender in Resend, e.g. "Bina Adult Care <website@binaadultcare.com>"
CONTACT_FROM_EMAIL=

# ─── Admin dashboard (/admin) ────────────────────────────────────
# The single login for the dashboard. Choose a strong password (12+ characters).
# Changing the password signs everyone out.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Vercel → Project → Settings → Git → Deploy Hooks → create one for your production
# branch. The dashboard's "Publish website" button calls it to rebuild the site.
VERCEL_DEPLOY_HOOK_URL=
